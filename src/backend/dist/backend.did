type Voucher = 
 record {
   code: text;
   email: text;
   endDate: text;
   issuedAt: int;
   programCode: text;
   startDate: text;
   used: bool;
   value: nat;
 };
type VerifyResult = 
 variant {
   err: text;
   ok;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UpgradeState = 
 record {
   devices: vec DeviceEntry;
   menus: vec MenuEntry;
   orders: vec OrderEntry;
   pendingActivations: vec PendingActivationEntry;
   restaurantMenuOverrides: vec RestaurantMenuOverrideEntry;
   restaurants: vec RestaurantEntry;
 };
type TimeSlot = 
 record {
   durationMinutes: nat;
   startHour: nat;
   startMinute: nat;
 };
type StoreHours = 
 record {
   closeHour: nat;
   closeMinute: nat;
   openHour: nat;
   openMinute: nat;
 };
type SendCodeResult = 
 variant {
   err: text;
   ok;
 };
type SalesTier = 
 record {
   minSales: nat;
   voucherValue: nat;
 };
type SalesPromo = 
 record {
   active: bool;
   code: text;
   endDate: text;
   monthlyTiers: vec SalesTier;
   name: text;
   startDate: text;
   termsUrl: text;
   voucherValidDays: nat;
   weeklyTiers: vec SalesTier;
 };
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_9 = 
 variant {
   err: text;
   ok: vec SalesPromo;
 };
type Result_8 = 
 variant {
   err: text;
   ok: Device;
 };
type Result_7 = 
 variant {
   err: text;
   ok;
 };
type Result_6 = 
 variant {
   err: text;
   ok: nat;
 };
type Result_5 = 
 variant {
   err: text;
   ok: MenuItem;
 };
type Result_4 = 
 variant {
   err: text;
   ok: Promotion;
 };
type Result_3 = 
 variant {
   err: text;
   ok: RegistrationPromo;
 };
type Result_2 = 
 variant {
   err: text;
   ok: Restaurant;
 };
type Result_17 = 
 variant {
   err: Error;
   ok;
 };
type Result_16 = 
 variant {
   err: text;
   ok: record {
         discountAmount: nat;
         promotionCode: text;
       };
 };
type Result_15 = 
 variant {
   err: text;
   ok: PendingActivation;
 };
type Result_14 = 
 variant {
   err: text;
   ok: OrderStatus;
 };
type Result_13 = 
 variant {
   err: text;
   ok: bool;
 };
type Result_12 = 
 variant {
   err: text;
   ok: opt Voucher;
 };
type Result_11 = 
 variant {
   err: text;
   ok: vec Promotion;
 };
type Result_10 = 
 variant {
   err: text;
   ok: vec RegistrationPromo;
 };
type Result_1 = 
 variant {
   err: text;
   ok: SalesPromo;
 };
type Result = 
 variant {
   err: text;
   ok: Order;
 };
type RestaurantMenuOverrideEntry = 
 record {
   overrides: vec record {
                    text;
                    nat;
                  };
   restaurantId: text;
 };
type RestaurantId = text;
type RestaurantEntry = 
 record {
   restaurant: Restaurant;
   restaurantId: text;
 };
type Restaurant = 
 record {
   address: text;
   name: text;
   phone: text;
   restaurantId: text;
   visible: bool;
 };
type RegistrationPromo = 
 record {
   active: bool;
   code: text;
   endDate: text;
   name: text;
   startDate: text;
   termsUrl: text;
   voucherValidDays: nat;
   voucherValue: nat;
 };
type Promotion = 
 record {
   active: bool;
   code: text;
   dailyOrderLimit: nat;
   daysOfWeek: vec bool;
   endDate: text;
   name: text;
   perCustomerDailyLimit: nat;
   startDate: text;
   termsUrl: text;
   tiers: vec DiscountTier;
   timeSlots: vec TimeSlot;
 };
type PendingActivationEntry = 
 record {
   activation: PendingActivation;
   code: text;
 };
type PendingActivation = 
 record {
   code: text;
   createdAt: int;
   expiresAt: int;
   restaurantId: text;
   role: DeviceRole;
   used: bool;
 };
type PaymentStatus = 
 variant {
   expired;
   paid;
   refunded;
   unpaid;
 };
type OrderStatus = 
 record {
   bookingStatus: BookingStatus;
   invoiceId: text;
   invoiceStatus: InvoiceStatus;
   paymentStatus: PaymentStatus;
   pdfUrl: text;
   sharedLink: text;
   tingeeQrCode: text;
   tingeeQrId: text;
 };
type OrderItem = 
 record {
   itemId: text;
   name: text;
   price: nat;
   quantity: nat;
   unitName: text;
   vatRate: nat;
 };
type OrderId = text;
type OrderEntry = 
 record {
   order: Order;
   orderId: OrderId;
 };
type Order = 
 record {
   ahamoveOrderId: text;
   amount: nat;
   billId: opt text;
   bookingStatus: BookingStatus;
   createdAt: int;
   cusAddress: text;
   cusName: text;
   cusPhone: text;
   cusTaxCode: text;
   expireAt: opt nat64;
   goodsAmount: nat;
   invoiceId: text;
   invoiceStatus: InvoiceStatus;
   items: vec OrderItem;
   kmDiscountAmount: nat;
   orderId: text;
   paymentStatus: PaymentStatus;
   paymentVerificationImage: text;
   pdfUrl: text;
   pickupCode: text;
   qrCode: opt text;
   receiverEmail: text;
   restaurantId: text;
   sharedLink: text;
   shippingFee: nat;
   taxTotal: nat;
   tingeeQrCode: text;
   tingeeQrId: text;
   updatedAt: int;
   voucherDiscountAmount: nat;
 };
type MenuItem = 
 record {
   category: text;
   image: blob;
   itemId: text;
   name: text;
   price: nat;
   unitName: text;
   vatRate: nat;
   visible: bool;
 };
type MenuEntry = 
 record {
   itemId: text;
   menu: MenuItem;
 };
type InvoiceStatus = 
 variant {
   failed;
   invoiced;
   none;
 };
type Hmac = text;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type EnterpriseRole = 
 variant {
   accounting;
   paymentQueue;
   salesPromoReporting;
 };
type Email = text;
type DiscountTier = 
 record {
   discountAmount: nat;
   minOrderValue: nat;
 };
type DeviceRole = 
 variant {
   accounting;
   admin;
   cashier;
   driver;
   paymentQueue;
   salesPromoReporting;
 };
type DeviceId = text;
type DeviceEntry = 
 record {
   device: Device;
   deviceId: text;
 };
type Device = 
 record {
   activatedAt: int;
   active: bool;
   deviceId: text;
   name: text;
   phone: text;
   restaurantId: text;
   role: DeviceRole;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type BookingStatus = 
 variant {
   cancelled;
   completed;
   confirmed;
   pending;
   pickedUp;
   shipping;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result_17);
  _internet_identity_sign_in_start: () -> (blob);
  activateDevice: (code: text, deviceId: DeviceId, name: text, phone:
   text) -> (Result_8);
  addItem: (itemId: text, name: text, price: nat, unitName: text, vatRate:
   nat, category: text, image: blob) -> (Result_5);
  addRestaurant: (restaurantId: text, name: text, address: text, phone:
   text) -> (Result_2);
  applyPromotion: (email: text, orderAmount: nat, hmac: Hmac) -> (Result_16);
  applyVoucher: (email: text, code: text, orderAmount: nat, hmac: Hmac) ->
   (Result_6);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  callerHasEnterpriseRole: (deviceId: DeviceId, role: EnterpriseRole) ->
   (bool) query;
  cancelOrder: (orderId: text, hmac: text) -> (Result);
  changeOrderRestaurant: (orderId: text, newRestaurantId: text, hmac:
   text) -> (Result);
  cleanupExpiredActivations: () -> (nat);
  cleanupOrderByDevice: (deviceId: text, orderId: text) -> (Result);
  confirmPaymentByDevice: (deviceId: text, orderId: text) -> (Result);
  countVouchersByProgram: (programCode: text) -> (nat) query;
  createOrder: (orderId: text, restaurantId: text, cusName: text, cusPhone:
   text, cusAddress: text, cusTaxCode: text, receiverEmail: text, items:
   vec OrderItem, amount: nat, goodsAmount: nat, shippingFee: nat, taxTotal:
   nat, ahamoveOrderId: text, tingeeQrId: text, sharedLink: text,
   tingeeQrCode: text, pickupCode: text, kmDiscountAmount: nat,
   voucherDiscountAmount: nat, hmac: text) -> (Result);
  createPromotion: (deviceId: text, name: text, startDate: text, endDate:
   text, daysOfWeek: vec bool, timeSlots: vec TimeSlot, dailyOrderLimit: 
   nat, perCustomerDailyLimit: nat, tiers: vec DiscountTier, termsUrl:
   text) -> (Result_4);
  createRegistrationPromo: (deviceId: text, name: text, startDate: text,
   endDate: text, voucherValue: nat, voucherValidDays: nat, termsUrl:
   text) -> (Result_3);
  createSalesPromo: (deviceId: text, name: text, startDate: text, endDate:
   text, weeklyTiers: vec SalesTier, monthlyTiers: vec SalesTier,
   voucherValidDays: nat, termsUrl: text) -> (Result_1);
  deactivateExpiredPromotions: (hmac: Hmac) -> (Result_6);
  deleteItem: (itemId: text) -> (Result_7);
  deletePromotion: (deviceId: text, code: text) -> (Result_7);
  deleteRegistrationPromo: (deviceId: text, code: text) -> (Result_7);
  deleteRestaurant: (restaurantId: text) -> (Result_7);
  deleteSalesPromo: (deviceId: text, code: text) -> (Result_7);
  execute: (qJson: text) -> (Result__1) query;
  generateActivationCode: (restaurantId: RestaurantId, role: DeviceRole) ->
   (Result_15);
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  /// Returns the canister's own id as text, so the VPS knows which canister
  /// it is talking to. `Principal.fromActor(Main)` resolves the actor's own
  /// canister principal at runtime (mo:core/IC.getCanisterId does not exist in
  /// core 2.6.1).
  getCanisterIdText: () -> (text) query;
  getCurrentPromotion: () -> (opt Promotion) query;
  getCurrentRegistrationPromo: () -> (opt RegistrationPromo) query;
  getCurrentSalesPromo: () -> (opt SalesPromo) query;
  getItemImage: (itemId: text) -> (opt blob) query;
  getKmDailyCount: (programCode: text) -> (nat) query;
  getKmUsageCount: (email: text, programCode: text) -> (nat) query;
  getMenu: () -> (vec MenuItem) query;
  getMenuForRestaurant: (restaurantId: text) -> (vec MenuItem) query;
  getOrder: (orderId: text, deviceId: text) -> (Result);
  getOrderStatus: (orderId: text) -> (Result_14) query;
  getOrdersByEmail: (email: text, deviceId: text) -> (vec Order);
  getPaymentMode: () -> (text) query;
  getRestaurants: () -> (vec Restaurant) query;
  getStoreHours: () -> (StoreHours) query;
  getUpgradeState: () -> (UpgradeState);
  isCallerAdmin: () -> (bool) query;
  isEmailVerified: (email: Email) -> (bool) query;
  isPromotionUsed: (deviceId: text, code: text) -> (Result_13) query;
  isRegistrationPromoUsed: (deviceId: text, code: text) -> (Result_13) query;
  isSalesPromoUsed: (deviceId: text, code: text) -> (Result_13) query;
  isStoreOpen: () -> (bool) query;
  issueInvoiceByDevice: (deviceId: text, orderId: text, invoiceId: text,
   pdfUrl: text) -> (Result);
  issueSalesBonus: (email: text, periodType: text, periodKey: text,
   totalSales: nat, hmac: Hmac) -> (Result_12);
  listDevicesByRestaurant: (restaurantId: RestaurantId) -> (vec Device) query;
  listDevicesByRole: (role: DeviceRole) -> (vec Device) query;
  listMenus: () -> (vec MenuItem) query;
  listMyVouchers: (email: text) -> (vec Voucher) query;
  listOrders: (deviceId: text) -> (vec Order);
  listPaidOrdersForPickup: () -> (vec Order);
  listPendingPaymentOrders: (restaurantId: text, deviceId: text) ->
   (vec Order);
  listPromotions: (deviceId: text) -> (Result_11) query;
  listRegistrationPromos: (deviceId: text) -> (Result_10) query;
  listRestaurants: () -> (vec Restaurant) query;
  listSalesPromos: (deviceId: text) -> (Result_9) query;
  markPaymentExpired: (orderId: text, hmac: text) -> (Result);
  markPickedUp: (orderId: text) -> (Result);
  pruneOldOrdersNow: (hmac: text) -> (Result_6);
  restoreUpgradeState: ("blob": blob) -> (bool);
  revokeDevice: (deviceId: DeviceId) -> (Result_8);
  schema: () -> (text) query;
  seedMenuItems: () -> (bool);
  sendVerificationCode: (email: Email) -> (SendCodeResult);
  setItemVisible: (itemId: text, visible: bool) -> (Result_5);
  setPaymentMode: (mode: text) -> (Result_7);
  setRestaurantPriceOverride: (restaurantId: text, itemId: text, price:
   nat) -> (Result_7);
  setStoreHours: (hours: StoreHours) -> (Result_7);
  setVpsSecret: (newSecret: text) -> (variant {
                                        err: text;
                                        ok;
                                      });
  snapshotUpgradeState: () -> (blob);
  stopPromotion: (deviceId: text, code: text) -> (Result_4);
  stopRegistrationPromo: (deviceId: text, code: text) -> (Result_3);
  stopSalesPromo: (deviceId: text, code: text) -> (Result_1);
  tryConsumeKmSlot: (email: text, programCode: text, dailyLimit: nat, hmac:
   Hmac) -> (Result_6);
  updateInvoiceStatus: (orderId: OrderId, invoiceStatus: InvoiceStatus,
   invoiceId: text, pdfUrl: text, hmac: Hmac) -> (Result);
  updateItem: (itemId: text, name: text, price: nat, unitName: text, vatRate:
   nat, category: text, image: blob, visible: bool) -> (Result_5);
  updateOrderQr: (orderId: text, qrCode: opt text, billId: opt text,
   expireAt: opt nat64, hmac: text) -> (Result);
  updatePaymentStatus: (orderId: OrderId, paymentStatus: PaymentStatus, hmac:
   Hmac) -> (Result);
  updatePromotion: (deviceId: text, code: text, name: text, startDate: 
   text, endDate: text, daysOfWeek: vec bool, timeSlots: vec TimeSlot,
   dailyOrderLimit: nat, perCustomerDailyLimit: nat, tiers: vec DiscountTier,
   active: bool, termsUrl: text) -> (Result_4);
  updateRegistrationPromo: (deviceId: text, code: text, name: text,
   startDate: text, endDate: text, voucherValue: nat, voucherValidDays: 
   nat, active: bool, termsUrl: text) -> (Result_3);
  updateRestaurant: (restaurantId: text, name: text, address: text, phone:
   text, visible: bool) -> (Result_2);
  updateSalesPromo: (deviceId: text, code: text, name: text, startDate: 
   text, endDate: text, weeklyTiers: vec SalesTier, monthlyTiers:
   vec SalesTier, voucherValidDays: nat, active: bool, termsUrl: text) ->
   (Result_1);
  updateStatus: (orderId: OrderId, bookingStatus: BookingStatus, hmac:
   Hmac) -> (Result);
  verifyEmailCode: (email: Email, code: text) -> (VerifyResult);
}
